# Database Configuration
DATABASE_URL=postgresql://user:password@db:5432/tenant_portal

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock

# DNS Configuration (Cloudflare)
DNS_PROVIDER=cloudflare
DNS_API_TOKEN=your_cloudflare_api_token
DNS_ZONE_ID=your_cloudflare_zone_id
DNS_BASE_DOMAIN=cyantula.eu

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com

# Security
SECRET_KEY=your_secret_key_here
TOKEN_EXPIRY_HOURS=24

# Application
PORT=8000
HOST=0.0.0.0

# Proxmox Configuration
PROXMOX_API_URL=https://proxmox-vlan30:8006/api2/json
PROXMOX_API_TOKEN=your_proxmox_api_token

# VLAN Configuration
VLAN_IP_RANGE=192.168.30.0/24
VLAN_INTERFACE=eth1
